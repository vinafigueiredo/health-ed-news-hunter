# ── Supabase ──────────────────────────────────────────────────────────────────
# A chave SECRET (antiga service_role) bypassa RLS. NUNCA vai para o front-end.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=cole-a-secret-key-aqui

# ── LLM (gate de relevância) ──────────────────────────────────────────────────
# Todos têm free tier sem cartão. A cascata tenta nesta ordem e para no primeiro
# que responder. Configure pelo menos uma; com zero chaves o gate fica desligado
# e o feed vem só com filtro de keyword (mais ruído).
#
# ⚠️ NÃO ponha comentário na MESMA linha da chave. Com o valor vazio, o
# python-dotenv não remove o comentário — ele VIRA o valor. O robô então acha
# que o provedor está configurado e leva 401 em todo lote, além de gastar
# ~12s por lote tentando provedor morto. Aconteceu em 03/ago/2026.

# Free tier é cota POR CONTA e POR DIA. Para dobrar o teto sem trocar de
# modelo, acrescente _2, _3 ao nome da variável — o coletor descobre sozinho e
# passa para a próxima quando a anterior estoura. Vale para os quatro.

# https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=

# https://cloud.cerebras.ai/
CEREBRAS_API_KEY=
# CEREBRAS_API_KEY_2=

# https://console.mistral.ai/
MISTRAL_API_KEY=
# MISTRAL_API_KEY_2=

# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# GEMINI_API_KEY_2=

# Opcional — sobrescreve o modelo de cada provedor
# GROQ_MODEL=llama-3.3-70b-versatile
# CEREBRAS_MODEL=llama-3.3-70b
# MISTRAL_MODEL=mistral-small-latest
# GEMINI_MODEL=gemini-2.0-flash
